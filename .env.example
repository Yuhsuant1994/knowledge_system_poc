
# --- Postgres ---
POSTGRES_DB=knowledge_system
POSTGRES_USER=knowledge_system
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg2://knowledge_system:changeme@localhost:5432/knowledge_system
SALES_READONLY_DATABASE_URL=postgresql+psycopg2://sales_readonly:sales_readonly@localhost:5432/knowledge_system

# --- LLM (opensource Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_NUM_CTX=16384

# --- Embeddings (opensource Ollama) ---
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- GitHub MCP (read-only, locked to coroot/coroot) ---
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
GITHUB_REPO=coroot/coroot
MCP_GITHUB_COMMAND=github-mcp-server
MCP_GITHUB_ARGS=stdio

# --- HR source (PostHog handbook, public, no token needed) ---
HR_SOURCE_REPO=PostHog/posthog.com
HR_SOURCE_BRANCH=master
HR_SOURCE_PATH=contents/handbook/company
HR_UPDATE_LOOKBACK_DAYS=2

LOG_LEVEL=INFO
LOG_DIR=logs
ROLE_CACHE_TTL_SECONDS=3600

# --- Streamlit ---
FASTAPI_URL=http://localhost:8000
